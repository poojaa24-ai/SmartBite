# SmartBite Environment Configuration Example

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/smartbite

# Authentication
JWT_SECRET=smartbite_super_secure_jwt_token_secret_key_2026
JWT_EXPIRE=30d

# Client URLs (CORS)
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay Test Mode)
# Leave as test dummy keys to test simulated payments, or provide your Razorpay test key
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
SIMULATED_PAYMENT_ENABLED=true

# Upload Configuration
UPLOAD_PATH=./uploads
